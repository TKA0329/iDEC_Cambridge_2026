    print(f"Protein: {r['protein']}")
    print(f"Residues: {r['start']} - {r['end']}")
    print(f"Length: {r['length']} aa")
    print(f"Score: {round(r['score'], 2)}")
    print(f"GRAVY (hydropathy): {round(r['gravy'], 2)}")
    print(f"Net charge (pH {PHYSIO_PH}): {round(r['net_charge'], 2)}")
    print(f"Charge density: {round(r['charge_density'], 2)}")
    print(f"Cysteines: {r['cysteines']}")
    print(f"Sequence:\n{r['sequence']}")

